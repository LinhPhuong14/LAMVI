# Supabase (T-03). Thiếu một trong ba biến → server dùng dữ liệu bộ nhớ (T-04).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chỉ dùng ở server, không bao giờ đưa vào frontend (T-05)
SUPABASE_SERVICE_ROLE_KEY=

PORT=5173
# URL web công khai — dùng cho link đặt lại mật khẩu
PUBLIC_SITE_URL=http://localhost:5173

# Dung lượng tối đa video lô (MB). Đặt ≤ giới hạn file của bucket batch-videos trong Supabase.
MAX_VIDEO_MB=500

# Chỉ khi chạy không có Supabase (dữ liệu bộ nhớ): tạo sẵn tài khoản admin để thử /admin
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_IT_EMAIL=
DEV_IT_PASSWORD=

# Dashboard IT (D-52): chỉ kiểm tra có cấu hình hay chưa, không hiển thị giá trị
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
OPENAI_API_KEY=
# Tuỳ chọn: mã commit hiển thị trên dashboard IT
GIT_COMMIT=
