# Supabase (T-03). Thiếu một trong ba biến → server dùng dữ liệu bộ nhớ (T-04).
SUPABASE_URL=
# Khoá mới: sb_publishable_… (thay SUPABASE_ANON_KEY — tên cũ vẫn nhận)
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_… (thay SUPABASE_SERVICE_ROLE_KEY — tên cũ vẫn nhận).
# Chỉ dùng ở server, không bao giờ đưa vào frontend (T-05)
SUPABASE_SECRET_KEY=

# Đăng nhập Google (T-44, D-78): OAuth client loại Web ở Google Cloud Console.
# Authorized redirect URI: {PUBLIC_SITE_URL}/api/auth/google/callback. Thiếu một trong hai → ẩn nút.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PORT=5173
# URL web công khai — dùng cho link đặt lại mật khẩu
PUBLIC_SITE_URL=http://localhost:5173

# Dung lượng tối đa video lô (MB). Đặt ≤ giới hạn file của bucket batch-videos trong Supabase.
MAX_VIDEO_MB=500
# Dung lượng tối đa ảnh sản phẩm (MB). Bucket product-images trong Supabase.
MAX_IMAGE_MB=5

# Chỉ khi chạy không có Supabase (dữ liệu bộ nhớ): tạo sẵn tài khoản admin để thử /admin
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_IT_EMAIL=
DEV_IT_PASSWORD=

# Thanh toán payOS (FR-PAY-001, D-35). Thiếu một trong ba → checkout chỉ nhận COD.
# CHECKSUM_KEY dùng để xác minh chữ ký webhook (NFR-SEC-002) — không bao giờ đưa ra frontend.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# BR-PAY-003: bí mật cho lịch quét đơn payOS quá hạn (Vercel Cron gọi
# POST /api/internal/expire-orders với header Authorization: Bearer <CRON_SECRET>).
# Để trống → endpoint trả 404.
CRON_SECRET=
OPENAI_API_KEY=
# Tuỳ chọn: mã commit hiển thị trên dashboard IT
GIT_COMMIT=

# Google Analytics 4 (FR-GA-001, D-72). Dạng G-XXXXXXXXXX; giá trị sai định dạng bị bỏ qua.
# Để trống ở dev/Preview → không nhúng GA. D-72: không có banner đồng ý cookie.
GA_MEASUREMENT_ID=
# Báo cáo realtime ở /admin/analytics (GA4 Data API). Bỏ trống → trang báo "chưa cấu hình".
# GA_PROPERTY_ID: số (GA → Admin → Property details). Tạo service account trong Google Cloud, bật
# "Google Analytics Data API", rồi thêm email của nó vào GA (Property access management) vai trò Viewer.
GA_PROPERTY_ID=
# Dán nguyên JSON khoá service account (hoặc base64 của nó); hoặc dùng cặp GA_CLIENT_EMAIL + GA_PRIVATE_KEY
GA_SERVICE_ACCOUNT_JSON=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=

# AI Mây (D-67: OpenAI mặc định bật, admin tắt được ở /admin/may; thiếu OPENAI_API_KEY → FAQ offline)
OPENAI_MODEL=gpt-4o-mini
# Đơn giá USD / 1 triệu token để tính ngân sách tháng (FR-AI-007) — cập nhật theo bảng giá OpenAI
OPENAI_PRICE_INPUT_PER_1M=0.15
OPENAI_PRICE_OUTPUT_PER_1M=0.6
# Muối băm session/IP cho hạn mức tin nhắn Mây VÀ cho bộ chống dò/spam (G-20).
# Bắt buộc đặt giá trị bí mật riêng ở môi trường thật.
MAY_HASH_SALT=

# G-20: đặt RATE_LIMIT=0 để TẮT chống dò/spam. Chỉ dùng cho test tự động — không đặt ở môi
# trường thật. Ngưỡng mặc định xem server/config.js.
RATE_LIMIT=
# Số proxy phía trước server (để lấy IP thật). Để trống khi chạy trực tiếp.
TRUST_PROXY=

# Vercel: đặt các biến này trong Project Settings (không commit). Xem docs/knowledge/deploy-vercel.md.
# Production cần đủ SUPABASE_*, PUBLIC_SITE_URL = domain thật, TRUST_PROXY=1, MAY_HASH_SALT riêng,
# GA_MEASUREMENT_ID (chỉ Production, không đặt ở Preview để không lẫn số liệu).
