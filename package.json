{
  "name": "lamvi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch-path=server server/index.js",
    "dev:api": "API_ONLY=1 node --env-file-if-exists=.env --watch-path=server server/index.js",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.jsx --outDir dist/server",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed-sql": "node scripts/gen-seed-sql.js",
    "gen:og": "node scripts/gen-og-image.js",
    "gen:mail-banner": "python3 scripts/gen_mail_banner.py"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.11",
    "express": "^5.2.1",
    "framer-motion": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "supertest": "^7.3.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
